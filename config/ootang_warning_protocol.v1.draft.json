{
  "protocol_id": "ootang-five-level-rule-v1",
  "protocol_version": "1.0-draft",
  "status": "draft",
  "case": "ootang",
  "revision_date": "2026-07-18",
  "formal_run_policy": "A draft protocol must not be used to generate formal warning results.",
  "source_evidence": [
    {
      "source": "docs/advisor_review_action_plan.md",
      "role": "latest user and mentor decisions"
    },
    {
      "source": "literature/物理引导的阶跃型水库滑坡变形智能概率预测模型与预警方法研究.docx",
      "role": "five-level indicator framework and source formulas"
    },
    {
      "source": "literature/一种改进的切线角及对应的滑坡预警判据_许强.pdf",
      "role": "original improved-tangent-angle phase boundaries and stable-stage procedure"
    }
  ],
  "confirmed": {
    "kinematics": {
      "velocity_formula": "v_i=(U_i-U_{i-1})/(t_i-t_{i-1})",
      "delta_v_formula": "delta_v_i=v_i-v_{i-1}",
      "velocity_unit": "mm/day",
      "invalid_time_handling": "nonpositive_or_missing_dt_is_invalid"
    },
    "warning_levels": [
      "green",
      "blue",
      "yellow",
      "orange",
      "red"
    ],
    "interval": {
      "semantic": "observed_per_timepoint_interval_deviation_state_identification",
      "not_claimed": "strict_horizon_ahead_warning",
      "candidate": {
        "status": "draft_candidate_not_formal",
        "input_scope": "split_equals_calibration_for_global_diagnostics; observed_rows_for_state_identification",
        "mu": "P50",
        "sigma_formula": "(P90-P10)/(2*1.28155)",
        "standard_normal_p90_quantile": 1.28155,
        "mapping": {
          "green": "U<=mu",
          "blue": "mu<U<=mu+sigma",
          "yellow": "mu+sigma<U<=mu+2*sigma",
          "orange": "mu+2*sigma<U<=mu+3*sigma",
          "red": "U>mu+3*sigma"
        },
        "required_global_checks": [
          "quantile_order",
          "coverage",
          "symmetry",
          "tail"
        ],
        "global_gate_policy": "all_four_checks_must_be_explicitly_passed; no_default_threshold_or_pass_decision",
        "row_status_policy": "source_warmup_invalid_or_not_applicable_is_preserved; nonfinite_or_crossed_quantiles_are_invalid; otherwise_a_failed_or_unconfigured_global_gate_is_not_applicable",
        "diagnostic_outputs": [
          "quantile_order_failures",
          "coverage_80",
          "midpoint_error",
          "standardized_residual_summary"
        ]
      }
    },
    "tangent_angle": {
      "green": "alpha<45_degree",
      "blue": "alpha_approximately_45_degree",
      "yellow": "45_degree<alpha<80_degree",
      "orange": "80_degree<=alpha<85_degree",
      "red": "alpha>=85_degree"
    },
    "v0_framework": {
      "formula": "V0=max(1.5*V, V+2*sigma)",
      "V_definition": "average_rate_of_selected_initial_displacement",
      "granularity": "per_station",
      "legacy_30_day_rate_allowed": false,
      "stable_segment_candidate": {
        "status": "draft_candidate_not_formal",
        "input": "per_station_valid_point_velocity_rows",
        "fit_only": true,
        "algorithm": "two_cluster_kmeans_initial_low_speed_prefix",
        "n_clusters": 2,
        "init": "random",
        "random_state": 0,
        "n_init": 20,
        "openmp_threads": 1,
        "low_speed_class": "cluster_with_lower_center",
        "prefix_rule": "select_only_the_contiguous_low_speed_prefix_from_the_first_valid_velocity",
        "sigma": {
          "definition": "sample_standard_deviation_of_selected_point_velocities",
          "ddof": 1,
          "status": "draft_implementation_convention"
        },
        "failure_policy": "emit_failed_selection_without_skipping_to_a_later_segment",
        "local_extrema": "boundary_audit_only_until_window_and_conflict_rules_are_frozen",
        "audit_fields": [
          "cluster_centers",
          "first_valid_velocity_date",
          "first_valid_velocity",
          "segment_start_date",
          "segment_end_date",
          "n_selected_velocities",
          "openmp_threads",
          "V",
          "sigma",
          "V0",
          "failure_reason"
        ]
      }
    },
    "delta_v": {
      "role": "auxiliary_trend_input",
      "states": [
        "negative",
        "near_zero",
        "positive"
      ],
      "diagnostic_candidate": {
        "status": "diagnostic_only_no_tolerance_decision",
        "source_splits": [
          "fit",
          "calibration"
        ],
        "fit_kinematics_scope": "all_station_history_through_fit_cutoff",
        "calibration_kinematics_scope": "exact_station_calibration_prediction_dates",
        "near_zero_tolerance": "unconfigured",
        "audit_fields": [
          "n_valid_delta_v",
          "delta_v_min",
          "delta_v_max",
          "delta_v_mean",
          "delta_v_median",
          "delta_v_std_ddof1",
          "mean_abs_delta_v",
          "median_abs_delta_v",
          "max_abs_delta_v"
        ]
      }
    },
    "fusion": {
      "mode": "transparent_non_supervised_rules",
      "inputs": [
        "interval",
        "velocity",
        "delta_v",
        "tangent_angle"
      ],
      "outputs": [
        "per_station",
        "landslide_body"
      ],
      "ngboost_is_formal_path": false,
      "per_station_candidate": {
        "status": "draft_candidate_not_formal",
        "required_inputs": [
          "interval_level",
          "velocity_level",
          "delta_v_state",
          "tangent_angle_level"
        ],
        "input_status_policy": "all_four_inputs_must_be_valid; otherwise preserve_warmup_invalid_or_not_applicable",
        "minimum_support": 2,
        "ordinal_support_rule": "interval_velocity_and_tangent_angle_support_level_L_when_their_level_is_at_least_L",
        "positive_delta_v_rule": "positive_delta_v_is_qualitative_escalation_support_at_each_non_green_level",
        "negative_or_near_zero_delta_v_rule": "not_escalation_support",
        "level_rule": "emit_the_highest_non_green_level_with_at_least_two_supports",
        "no_corroboration_rule": "all_ordinal_green_with_nonpositive_delta_v_is_green; any_lone_anomaly_is_uncorroborated_not_green",
        "audit_fields": [
          "input_statuses",
          "candidate_max_level",
          "support_by_level",
          "contributing_indicators",
          "fusion_reason"
        ]
      }
    }
  },
  "unresolved_items": [
    {
      "id": "stable_segment_selection",
      "reason": "The cited tangent-angle paper requires an identified stable stage, while the specified thesis does not give an Ootang-reproducible start/end rule for the selected initial displacement.",
      "required_before_formal_run": true
    },
    {
      "id": "v0_blue_tolerance",
      "reason": "The source writes V approximately equal to V0 but gives no numeric tolerance or boundary ownership.",
      "required_before_formal_run": true
    },
    {
      "id": "tangent_blue_tolerance",
      "reason": "The source writes alpha approximately equal to 45 degrees but gives no numeric tolerance or boundary ownership for the blue tangent-angle level.",
      "required_before_formal_run": true
    },
    {
      "id": "rate_orange_expression",
      "reason": "The specified thesis table writes 5V0<=alpha<10V0 in a rate table; this is dimensionally inconsistent and must not be silently corrected.",
      "required_before_formal_run": true
    },
    {
      "id": "delta_v_near_zero_tolerance",
      "reason": "The source supports negative/near-zero/positive trend states but supplies no Ootang numeric near-zero tolerance.",
      "required_before_formal_run": true
    },
    {
      "id": "interval_calibration_gate",
      "reason": "Quantile-order, coverage, symmetry, tail-diagnostic and fallback thresholds must be fixed before a normal-distribution-style five-level interval mapping is used.",
      "required_before_formal_run": true
    },
    {
      "id": "per_station_fusion_function",
      "reason": "The specified thesis uses supervised multinomial logistic regression; the approved non-supervised replacement still needs a transparent rule table F.",
      "required_before_formal_run": true
    },
    {
      "id": "landslide_body_fusion_function",
      "reason": "The approved multi-station output requires a traceable F_site and contribution-station rule.",
      "required_before_formal_run": true
    },
    {
      "id": "nonregular_tangent_handling",
      "reason": "The original tangent-angle paper recommends equal-interval monitoring before angle calculation; the current Ootang data are daily, but a missing/nonregular-data rule is still needed.",
      "required_before_formal_run": true
    }
  ]
}
